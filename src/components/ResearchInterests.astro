---
import { getCollection } from 'astro:content';

const interests = (await getCollection('interests')).sort((a, b) => a.data.order - b.data.order);
---

<section class="sections">
	<h2 class="section-title">Research interests & expertise</h2>
	<div class="keyword-groups keyword-groups-3">
		{
			interests.map(({ data }) => (
				<div class="keyword-group">
					<h3>{data.topic}</h3>
					<ul class="chips">{data.items.map((item) => <li class="tag">{item}</li>)}</ul>
				</div>
			))
		}
	</div>
</section>
