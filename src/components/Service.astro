---
import { getCollection } from 'astro:content';
import Ledger from './Ledger.astro';

const service = (await getCollection('service')).sort((a, b) => a.data.order - b.data.order);
---

<section class="sections">
	<h2 class="section-title">Professional Service</h2>
	<ol class="ledger">
		{
			service.map(({ data }) => (
				<Ledger label={data.duration}>
					<h3>{data.organization}</h3>
					<span class="ledger-meta">{data.role}</span>
				</Ledger>
			))
		}
	</ol>
</section>
