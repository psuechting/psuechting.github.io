---
import { getCollection } from 'astro:content';
import Ledger from './Ledger.astro';

const publications = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
---

<section class="sections">
	<h2 class="section-title">Publications</h2>
	<ol class="ledger">
		{
			publications.map(({ data }) => (
				<Ledger label={data.year}>
					<h3>{data.url ? <a href={data.url} target="_blank" rel="noopener">{data.citation}</a> : data.citation}</h3>
					<span class="ledger-meta">{data.venue}</span>
				</Ledger>
			))
		}
	</ol>
</section>
