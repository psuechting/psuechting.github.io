---
import { getCollection } from 'astro:content';
import Ledger from './Ledger.astro';

const awards = (await getCollection('awards')).sort((a, b) => a.data.order - b.data.order);
---

<section class="sections">
	<h2 class="section-title">Fellowships & Awards</h2>
	<ol class="ledger">
		{
			awards.map(({ data }) => (
				<Ledger label={data.years}>
					<h3><a href={data.url}>{data.title}</a></h3>
					<span class="ledger-meta">{data.organization}</span>
					<details class="award-details">
						<summary>About this award</summary>
						<p class="desc-text">{data.description}</p>
					</details>
				</Ledger>
			))
		}
	</ol>
</section>
