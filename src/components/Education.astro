---
import { getCollection } from 'astro:content';
import Ledger from './Ledger.astro';

const degrees = (await getCollection('education')).sort((a, b) => b.data.year - a.data.year);
---

<section class="sections">
	<h2 class="section-title">Education</h2>
	<ol class="ledger">
		{
			degrees.map(({ data }) => (
				<Ledger label={data.year}>
					<h3>{data.degree}</h3>
					<span class="ledger-meta">{data.institution} · {data.location}</span>
				</Ledger>
			))
		}
	</ol>
</section>
