---
import { profile } from '../data/profile';
import Icon from './Icon.astro';
import Email from './Email.astro';
---

<footer class="container site-footer" id="contact">
	<h2 class="section-title">Contact</h2>
	<ul class="contact-list">
		{
			profile.emails.map((email) => (
				<li>
					<span class="contact-label">{email.label}</span>
					<Email address={email.address} />
				</li>
			))
		}
		{
			profile.social.map((link) => (
				<li>
					<span class="contact-label">{link.label}</span>
					<a href={link.url} rel="me">
						<Icon name={link.platform} /> {link.url.replace(/^https:\/\/(www\.)?/, '')}
					</a>
				</li>
			))
		}
	</ul>
	<p class="copyright">© {new Date().getFullYear()} {profile.name}</p>
</footer>
