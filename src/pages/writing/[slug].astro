---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { profile } from '../../data/profile';
import { formatDate, getPublishedPosts, readingTime } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;
---

<Base title={`${data.title} | ${profile.name}`} description={data.description}>
	<main class="container article">
		<a class="back-link" href="/writing/">← Writing</a>
		<h1 class="article-title">{data.title}</h1>
		<p class="article-meta">
			<time datetime={data.date.toISOString()}>{formatDate(data.date)}</time> · {readingTime(post.body)}
			{data.updated && <> · Updated {formatDate(data.updated)}</>}
		</p>
		{data.tags.length > 0 && (
			<p class="tag-list">{data.tags.map((tag) => <a class="tag" href={`/writing/tags/${tag}/`}>{tag}</a>)}</p>
		)}
		<div class="prose"><Content /></div>
	</main>
</Base>
