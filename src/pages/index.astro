---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Education from '../components/Education.astro';
import Skills from '../components/Skills.astro';
import Employment from '../components/Employment.astro';
import ResearchInterests from '../components/ResearchInterests.astro';
import Publications from '../components/Publications.astro';
import Awards from '../components/Awards.astro';
import ResearchExperience from '../components/ResearchExperience.astro';
import Service from '../components/Service.astro';
import { profile } from '../data/profile';
---

<Base>
	<Hero />
	<main>
		<About />
		<div class="container">
			<Education />
			<Skills />
		</div>
		<div class="container"><Employment /></div>
		<div class="container"><ResearchInterests /></div>
		<div class="container">
			<Publications />
			<Awards />
		</div>
		<div class="container">
			<ResearchExperience />
			<Service />
		</div>
	</main>
	<footer class="container">
		<span>© {new Date().getFullYear()} {profile.name}</span>
	</footer>
</Base>
