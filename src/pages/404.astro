---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
---

<Base title={`Page not found | ${profile.name}`} description="That page doesn't exist.">
	<main id="main" class="container article">
		<span class="feature-eyebrow">404</span>
		<h1 class="article-title">Page not found</h1>
		<p class="article-meta">That address doesn't exist here. It may have moved, or the link may be out of date.</p>
		<p class="hero-actions">
			<a class="button button-primary" href="/">Home</a>
			<a class="button" href="/about/">About</a>
			<a class="button" href="/#research">Research</a>
			<a class="button" href={profile.cvPath}>CV</a>
		</p>
	</main>
</Base>
